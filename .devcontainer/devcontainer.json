{
  "name": "nextcloud-desktop-rs",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "fill-labs.dependi"
      ],
      "settings": {
        "lldb.executable": "/usr/bin/lldb",
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer",
          "editor.formatOnSave": true
        },
        "rust-analyzer.check.command": "clippy"
      }
    }
  },
  "initializeCommand": "xhost +SI:localuser:$(id -un) || true",
  "runArgs": [
    "--security-opt=label=disable",
    "--device=/dev/dri"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
    "DBUS_SESSION_BUS_ADDRESS": "${localEnv:DBUS_SESSION_BUS_ADDRESS}",
    "XCURSOR_SIZE": "24",
    "XCURSOR_THEME": "Adwaita"
  },
  "mounts": [
    {
      "source": "/tmp/.X11-unix",
      "target": "/tmp/.X11-unix",
      "type": "bind"
    },
    {
      "source": "${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY}",
      "target": "${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY}",
      "type": "bind"
    },
    {
      "source": "${localEnv:XDG_RUNTIME_DIR}/bus",
      "target": "${localEnv:XDG_RUNTIME_DIR}/bus",
      "type": "bind"
    }
  ],
  "remoteUser": "vscode"
}
